if(NOT DEFINED SHADER_DIR OR NOT DEFINED OUTPUT_FILE)
  message(FATAL_ERROR "EmbedShaders.cmake requires SHADER_DIR and OUTPUT_FILE")
endif()

file(GLOB_RECURSE shader_files RELATIVE "${SHADER_DIR}" "${SHADER_DIR}/*.glsl")
list(SORT shader_files)

set(contents "// Generated by EmbedShaders.cmake. Do not edit.\n")

foreach(rel IN LISTS shader_files)
  file(READ "${SHADER_DIR}/${rel}" src)

  string(FIND "${src}" ")CATALYST_SHADER\"" pos)
  if(NOT pos EQUAL -1)
    message(FATAL_ERROR "Shader '${rel}' contains the raw string delimiter")
  endif()

  string(APPEND contents "  {\"${rel}\", R\"CATALYST_SHADER(${src})CATALYST_SHADER\"},\n")
endforeach()

# Write the output directly. Using copy_if_different here would leave an
# unchanged file with an old timestamp, making the build rule re-run forever.
file(WRITE "${OUTPUT_FILE}" "${contents}")
